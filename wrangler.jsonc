{
  // Worker Cloudflare "tokyo": serve i file statici dell'app generati in ./dist
  // Pubblicazione automatica: Cloudflare Workers Builds a ogni push su main
  "name": "tokyo",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
